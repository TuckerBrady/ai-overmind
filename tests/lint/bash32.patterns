# bash 3.2 forbidden constructs (TEST_STRATEGY 4), read by tests/lint/bash32.sh.
# One per line: name<TAB>ERE<TAB>allow-ERE (optional; a line matching it is exempt).
# Lines starting with # and blank lines are skipped.
case-modification	\$\{[A-Za-z_][A-Za-z0-9_]*(,,|\^\^|,|\^)\}
mapfile/readarray/coproc	(^|[^A-Za-z0-9_])(mapfile|readarray|coproc)([^A-Za-z0-9_]|$)
associative-array	(declare|local|typeset) -[a-zA-Z]*A
nameref	(declare|local|typeset) -[a-zA-Z]*n
printf-time-format	printf[^|]*%\([^)]*\)T
EPOCHSECONDS/EPOCHREALTIME	EPOCHSECONDS|EPOCHREALTIME	:-
pipe-stderr	\|&
append-both	&>>
case-fallthrough	;;&|(^|[^;]);&([[:space:]]|$)
transform-operator	\$\{[A-Za-z_]+@[QEPAa]\}
negative-index	\[-[0-9]+\]
wait-n	wait -n
shopt-bash4	shopt -s[^#]*(globstar|lastpipe)
